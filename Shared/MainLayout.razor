@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    @Body
</MudLayout>

@code {
    // Optima-teal (UX-koncept "STR - Design Mockups") ersätter tidigare blått tema.
    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1f5551",
            Secondary = "#33827c",
            AppbarBackground = "#1f5551",
            Background = "#F5F5F5",
            Surface = "#FFFFFF",
        }
    };
}

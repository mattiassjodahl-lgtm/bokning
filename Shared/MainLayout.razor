@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    @Body
</MudLayout>

@code {
    // Matchar skarpa produkten optimasmart.se (avläst 2026-08-27) — ersätter tidigare UX-mockup-teal.
    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#297380",
            Secondary = "#63a336",
            Tertiary = "#fd8d3b",
            Info = "#3ca6ac",
            Success = "#45a78f",
            Warning = "#fd8d3b",
            Error = "#c62828",
            AppbarBackground = "#297380",
            AppbarText = "#ffffff",
            DrawerBackground = "#ffffff",
            DrawerText = "#246467",
            Background = "#F5F5F5",
            Surface = "#FFFFFF",
            TextPrimary = "#246467",
            TextSecondary = "#3a3a3a",
        }
    };
}

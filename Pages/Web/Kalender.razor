@page "/webb/kalender"
@layout PublicLayout
@inject WebsiteService Web

<PageTitle>Bokningskalender – @Web.School.Name</PageTitle>

<section class="ps-section">
    <div class="ps-wrap">
        <h1>Bokningskalender</h1>
        <p class="ps-lead">Lediga tider den kommande veckan. Vill du titta längre fram – välj ett datum nedan.</p>

        @* ── Filter ──────────────────────────────────────────────────────── *@
        <div class="ps-filterbar ps-mt">
            <fieldset class="ps-fieldset">
                <legend>Behörighet</legend>
                <div class="ps-filters">
                    <button type="button" class="ps-chip" aria-pressed="@(_selectedBeh.Count == 0 ? "true" : "false")"
                            @onclick="ClearBeh">Alla</button>
                    @foreach (var b in PresentBehorigheter(CurrentDays))
                    {
                        <button type="button" class="ps-chip" aria-pressed="@(_selectedBeh.Contains(b) ? "true" : "false")"
                                @onclick="() => ToggleBeh(b)">@b</button>
                    }
                </div>
            </fieldset>

            <div class="ps-field" style="max-width:260px">
                <label for="kaldatum">Titta längre fram</label>
                <input id="kaldatum" type="date" class="ps-input"
                       min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                       value="@(_pickedDate?.ToString("yyyy-MM-dd"))"
                       @onchange="OnPickDate" />
            </div>
        </div>

        @{
            var days = CurrentDays;
            var result = days
                .Select(d => new AvailableDay(d.Date, d.Slots.Where(MatchesBeh).ToList()))
                .Where(d => d.Slots.Count > 0)
                .ToList();
        }

        <p class="ps-hint ps-mt" aria-live="polite" role="status">
            @if (_pickedDate is null)
            {
                <text>Visar lediga tider kommande vecka.</text>
            }
            else
            {
                <text>
                    Visar <strong>@_pickedDate.Value.ToDateTime(TimeOnly.MinValue).ToString("dddd d MMMM", Sv)</strong>.
                    <button type="button" class="ps-linkbtn" @onclick="ResetDate">← Tillbaka till kommande vecka</button>
                </text>
            }
        </p>

        @if (result.Count == 0)
        {
            <div class="ps-note ps-mt" role="status">Inga lediga tider matchar ditt val. Prova ett annat datum eller ta bort behörighetsfiltret, eller kontakta oss.</div>
        }
        else
        {
            <div class="ps-mt" style="display:grid;gap:1.25rem">
                @foreach (var day in result)
                {
                    <article class="ps-card">
                        <h2 style="font-size:1.15rem;text-transform:capitalize">
                            @day.Date.ToDateTime(TimeOnly.MinValue).ToString("dddd d MMMM", Sv)
                        </h2>
                        <div class="ps-table-wrap" style="margin-top:.75rem">
                            <table class="ps-table">
                                <caption>Lediga tider @day.Date.ToDateTime(TimeOnly.MinValue).ToString("d MMMM", Sv)</caption>
                                <thead>
                                    <tr><th scope="col">Tid</th><th scope="col">Utbildning</th><th scope="col">Behörighet</th><th scope="col"><span class="visually-hidden">Status</span></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var slot in day.Slots)
                                    {
                                        <tr>
                                            <td>@slot.Start.ToString("HH:mm")–@slot.End.ToString("HH:mm")</td>
                                            <td>@slot.LessonType</td>
                                            <td>@slot.Behorighet</td>
                                            <td><span class="ps-badge ps-badge--open"><span class="material-icons" aria-hidden="true" style="font-size:16px">event_available</span> Ledig</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    private static readonly System.Globalization.CultureInfo Sv = new("sv-SE");

    private readonly HashSet<string> _selectedBeh = new();
    private DateOnly? _pickedDate;

    // Kommande vecka som standard; annars den valda dagen.
    private IReadOnlyList<AvailableDay> CurrentDays =>
        _pickedDate is null ? Web.GetAvailableSlots(7) : Web.GetAvailableSlots(_pickedDate.Value, 1);

    private IEnumerable<string> PresentBehorigheter(IReadOnlyList<AvailableDay> days) =>
        WebsiteService.Behorigheter.Where(b => days.Any(d => d.Slots.Any(s => s.Behorighet == b)));

    private bool MatchesBeh(AvailableSlot s) => _selectedBeh.Count == 0 || _selectedBeh.Contains(s.Behorighet);

    private void ToggleBeh(string b)
    {
        if (!_selectedBeh.Remove(b)) _selectedBeh.Add(b);
    }

    private void ClearBeh() => _selectedBeh.Clear();

    private void OnPickDate(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _pickedDate = DateOnly.TryParse(v, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;
    }

    private void ResetDate() => _pickedDate = null;
}

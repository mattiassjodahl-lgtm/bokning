@page "/webb/nyheter/{Slug}"
@layout PublicLayout
@inject WebsiteService Web
@inject NavigationManager Nav

<PageTitle>@(_news?.Title ?? "Nyhet") – @Web.School.Name</PageTitle>
<SeoHead Title="@_news?.Title" Description="@_news?.Summary" Path="@SeoPath" Image="@_news?.Image" OverrideDescription="@_news?.SeoDescription" OverrideImage="@_news?.SeoImage" Type="article" NoIndex="@(_news is null || IsPreview)" />

@if (IsPreview && _news is not null)
{
    <div class="ps-preview" role="status">
        <strong>Förhandsgranskning av den sparade versionen.</strong>
        @PreviewText
        <a href="/admin/hemsida">Till administrationen</a>
    </div>
}

@if (_news is null)
{
    <section class="ps-section">
        <div class="ps-wrap">
            <h1>Nyheten hittades inte</h1>
            <p class="ps-lead">Den här nyheten finns inte längre. Se <a href="/webb/nyheter">alla nyheter</a>.</p>
        </div>
    </section>
}
else
{
    @* ── Sub-hero ─────────────────────────────────────────────────────────── *@
    <section class="ps-hero ps-hero--sub ps-section" style="background-image:url('@_news.Image')">
        <div class="ps-wrap ps-hero__inner">
            <time datetime="@_news.Date.ToString("yyyy-MM-dd")" style="color:#dfeaf4;font-weight:600">
                @_news.Date.ToString("d MMMM yyyy", Sv)
            </time>
            <h1>@_news.Title</h1>
        </div>
    </section>

    @* ── Artikel (fast mall) ──────────────────────────────────────────────── *@
    <article class="ps-section">
        <div class="ps-wrap" style="max-width: 760px">
            <p class="ps-lead">@_news.Summary</p>

            @foreach (var para in Paragraphs)
            {
                <p>@para</p>
            }

            <div class="ps-hero__cta ps-mt">
                <a class="ps-btn ps-btn--primary" href="/webb/kalender">Boka tid</a>
                <a class="ps-btn ps-btn--outline" href="/webb/kontakt">Kontakta oss</a>
            </div>

            <p class="ps-mt"><a href="/webb/nyheter">← Alla nyheter</a></p>

            @if (!IsPreview)
            {
                <JsonLd Json="@ArticleJson" />
                <JsonLd Json="@BreadcrumbJson" />
            }
        </div>
    </article>
}

@code {
    private string SeoPath => "/webb/nyheter/" + (_news?.Slug ?? Slug);

    private static readonly System.Globalization.CultureInfo Sv = new("sv-SE");

    [Parameter] public string Slug { get; set; } = "";

    /// <summary>"?preview=1" i adressen. Gäller bara för inloggad administratör.</summary>
    [SupplyParameterFromQuery(Name = "preview")] public string? PreviewFlag { get; set; }

    [CascadingParameter(Name = "IsAdmin")] public bool IsAdmin { get; set; }

    private NewsItem? _news;

    // Utan inloggning ignoreras preview-flaggan helt: en opublicerad nyhet ger
    // då "hittades inte", precis som för alla andra besökare.
    private bool IsPreview => IsAdmin && PreviewFlag == "1";

    protected override void OnParametersSet() =>
        _news = IsPreview ? Web.FindNewsForPreview(Slug) : Web.GetNews(Slug);

    private string PreviewText => _news?.StatusOn(WebsiteService.Today) switch
    {
        NewsStatus.Scheduled => $"Nyheten är planerad och syns inte publikt förrän {_news.PublishFrom:yyyy-MM-dd}.",
        NewsStatus.Expired   => $"Nyheten är avpublicerad sedan {_news.PublishTo:yyyy-MM-dd} och syns inte publikt.",
        _                    => "Nyheten är publicerad och syns redan publikt.",
    };

    // Byggs i kod i stället för i markup: strängargumenten innehåller
    // citattecken, som inte går att ha inuti ett Razor-attribut.
    private string ArticleJson =>
        _news is null ? "" : StructuredData.NewsArticle(_news, Nav.BaseUri);

    private string BreadcrumbJson =>
        _news is null ? "" : StructuredData.Breadcrumbs(Nav.BaseUri,
            ("Hem", "/webb/start"),
            ("Nyheter", "/webb/nyheter"),
            (_news.Title, "/webb/nyheter/" + _news.Slug));

    // Delar upp brödtexten i stycken på dubbla radbrytningar.
    private IEnumerable<string> Paragraphs =>
        (_news?.Body ?? "").Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

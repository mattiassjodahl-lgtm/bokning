@page "/webb/ehandel"
@layout PublicLayout
@implements IAsyncDisposable
@inject WebsiteService Web
@inject IConfiguration Config
@inject IJSRuntime JS

<PageTitle>E-handel – @Web.School.Name</PageTitle>

<section class="ps-section">
    <div class="ps-wrap">
        <h1>E-handel</h1>
        <p class="ps-mt">Köp kurser och tillval direkt här på webben.</p>

        @* Optima Store monteras in i denna div via JS-interop, se wwwroot/js/optimaStore.js.
           Nycklarna hämtas från appsettings.json (OptimaStore-sektionen). *@
        <div id="optima-store" class="ps-mt"></div>
    </div>
</section>

@code {
    private const string ContainerId = "optima-store";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JS.InvokeVoidAsync("optimaStore.mount", ContainerId, new
        {
            scriptUrl = Config["OptimaStore:ScriptUrl"],
            apiKey = Config["OptimaStore:ApiKey"],
            apiUrl = Config["OptimaStore:BaseApiUrl"],
        });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("optimaStore.unmount", ContainerId);
        }
        catch (JSDisconnectedException)
        {
            // SignalR-kretsen är redan nedkopplad (t.ex. sidan stängd) – inget att städa upp.
        }
    }
}

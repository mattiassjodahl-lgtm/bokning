@inject WebsiteService Web
@inject ISnackbar Snackbar

<MudText Typo="Typo.h6" GutterBottom="true">Innehållssidor – utbildningar</MudText>
<MudText Typo="Typo.caption" Style="color:#666">
    Varje kort på startsidan länkar till en behörighetssida (<code>/webb/utbildning/&lt;länk&gt;</code>). Töm fältet "Länk" för att dölja sidan.
</MudText>

<MudExpansionPanels MultiExpansion="true" Class="my-4">
    @foreach (var card in Web.Settings.EducationCards)
    {
        var c = card;
        <MudExpansionPanel Text="@(string.IsNullOrWhiteSpace(c.Title) ? "(ny utbildning)" : c.Title)">
            <MudGrid>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="c.Title" Label="Titel" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="c.Slug" @bind-Value:event="oninput" Immediate="true"
                                  Label="Länk (slug)" Variant="Variant.Outlined"
                                  HelperText="t.ex. personbil-b. Tom = ingen egen sida."
                                  Error="@(SlugError(c) is not null)" ErrorText="@SlugError(c)" />
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoFixHigh"
                               OnClick="@(() => c.Slug = SlugUtil.From(c.Title))">Föreslå från titel</MudButton>
                    @if (SlugChanged(c))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                            @(string.IsNullOrWhiteSpace(c.Slug)
                                ? "Du tar bort länken. Sidan försvinner och kortet på startsidan slutar vara klickbart."
                                : $"Du ändrar länken från /webb/utbildning/{_savedSlugs[c]}.") 
                            Den gamla adressen slutar fungera och delade eller indexerade länkar visar "Utbildningen hittades inte".
                        </MudAlert>
                    }
                </MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="c.Description" Label="Kort beskrivning (på kortet)" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="8"><MudTextField @bind-Value="c.LongText" Label="Brödtext (på sidan)" Variant="Variant.Outlined" Lines="4" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="c.PriceFrom" Label="Prisindikation" Variant="Variant.Outlined" HelperText="t.ex. Från 950 kr/lektion" /></MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Det här ingår (en punkt per rad)" Variant="Variant.Outlined" Lines="4"
                                  Value="@string.Join("\n", c.Highlights)"
                                  ValueChanged="@(v => c.Highlights = SplitLines(v))" />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" GutterBottom="true">Bild</MudText>
                    <AdminImageUpload Value="@c.Image" ValueChanged="@(v => c.Image = v)" Subfolder="utbildningar" MinWidth="800" MinHeight="450" MaxKb="400"
                                      Spec="Liggande 16:9, ca 800×450 px. JPG/WebP."
                                      ShowAlt="true" AltValue="@c.ImageAlt" AltChanged="@(v => c.ImageAlt = v)" />
                </MudItem>
                <MudItem xs="12">
                    @if (c.HasPage)
                    {
                        <AdminSeoFields Title="@c.Title" Path="@EduPath(c)"
                                        Description="@c.SeoDescription" DescriptionChanged="@(v => c.SeoDescription = v)"
                                        Image="@c.SeoImage" ImageChanged="@(v => c.SeoImage = v)"
                                        FallbackDescription="@c.Description" DescriptionSource="den korta beskrivningen"
                                        ImageFallbackText="Tomt fält: utbildningens bild används, annars skolans standardbild." />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Utbildningen har ingen egen sida och syns därför inte i sökresultat. Ange en länk ovan för att styra beskrivning och delningsbild.
                        </MudAlert>
                    }
                </MudItem>
                <MudItem xs="12">
                    <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@(() => Web.Settings.EducationCards.Remove(c))">Ta bort utbildning</MudButton>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

<div style="display:flex; gap:.75rem">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Web.Settings.EducationCards.Add(new() { Title = "", Icon = "directions_car" }))">Lägg till utbildning</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Spara</MudButton>
</div>

@code {
    private static string EduPath(EducationCard c) => "/webb/utbildning/" + c.Slug;

    // Länkar som redan var sparade när fliken öppnades, för varning vid ändring.
    private readonly Dictionary<EducationCard, string> _savedSlugs = new(ReferenceEqualityComparer.Instance);

    protected override void OnInitialized() => RememberSlugs();

    private void RememberSlugs()
    {
        _savedSlugs.Clear();
        foreach (var c in Web.Settings.EducationCards.Where(c => !string.IsNullOrWhiteSpace(c.Slug)))
            _savedSlugs[c] = c.Slug;
    }

    private bool SlugChanged(EducationCard c) =>
        _savedSlugs.TryGetValue(c, out var saved) && !string.Equals(saved, c.Slug, StringComparison.Ordinal);

    private static List<string> SplitLines(string? text) =>
        (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    // En slug blir en publik adress. Två sidor med samma länk gör den andra
    // onåbar, eftersom uppslaget tar första träffen – därför nekas sparning.
    private string? SlugError(EducationCard card) =>
        SlugUtil.Error(card.Slug,
            Web.Settings.EducationCards.Where(o => !ReferenceEquals(o, card)).Select(o => o.Slug),
            allowEmpty: true);

    private void Save()
    {
        var trasiga = Web.Settings.EducationCards.Count(c => SlugError(c) is not null);
        if (trasiga > 0)
        {
            Snackbar.Add($"Rätta länken på {trasiga} utbildning(ar) innan du sparar.", Severity.Error);
            return;
        }

        Web.Save();
        RememberSlugs();
        Snackbar.Add("Utbildningar sparade", Severity.Success);
    }
}

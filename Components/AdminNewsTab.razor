@inject WebsiteService Web
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<MudText Typo="Typo.h6" GutterBottom="true">Nyheter</MudText>
<MudText Typo="Typo.caption" Style="color:#666">
    Visas i nyhetsblocket på startsidan (Layout A), i listningen <code>/webb/nyheter</code> och på egen sida <code>/webb/nyheter/&lt;länk&gt;</code>.
</MudText>

<MudExpansionPanels MultiExpansion="true" Class="my-4">
    @foreach (var news in Web.Settings.News)
    {
        var n = news;
        <MudExpansionPanel Text="@PanelTitle(n)">
            <MudGrid>
                <MudItem xs="12" md="8"><MudTextField @bind-Value="n.Title" Label="Rubrik" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Label="Datum" Variant="Variant.Outlined"
                                   HelperText="Visas på nyheten"
                                   Date="@n.Date.ToDateTime(TimeOnly.MinValue)"
                                   DateChanged="@(d => n.Date = DateOnly.FromDateTime(d ?? DateTime.Today))" />
                </MudItem>

                @* ── Publiceringsplanering ────────────────────────────────── *@
                <MudItem xs="12" md="4">
                    <MudDatePicker Label="Publicera från" Variant="Variant.Outlined" Clearable="true"
                                   HelperText="Tom = publiceras direkt"
                                   Date="@ToDateTime(n.PublishFrom)"
                                   DateChanged="@(d => n.PublishFrom = ToDateOnly(d))"
                                   Error="@(PeriodError(n) is not null)" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Label="Avpublicera efter" Variant="Variant.Outlined" Clearable="true"
                                   HelperText="Tom = visas tills du tar bort den"
                                   Date="@ToDateTime(n.PublishTo)"
                                   DateChanged="@(d => n.PublishTo = ToDateOnly(d))"
                                   Error="@(PeriodError(n) is not null)" ErrorText="@PeriodError(n)" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.body2" Color="@StatusColor(n)" Style="padding-top:1rem" role="status">@StatusText(n)</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility"
                               Href="@PreviewHref(n)" Target="_blank" Disabled="@(!CanPreview(n))" Class="mt-1">Förhandsgranska</MudButton>
                    @if (!CanPreview(n))
                    {
                        <MudText Typo="Typo.caption" Style="color:#666; display:block">Ange en giltig länk för att förhandsgranska.</MudText>
                    }
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="n.Slug" @bind-Value:event="oninput" Immediate="true"
                                  Label="Länk (slug)" Variant="Variant.Outlined"
                                  HelperText="t.ex. sommarkurser-2026"
                                  Error="@(SlugError(n) is not null)" ErrorText="@SlugError(n)" />
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoFixHigh"
                               OnClick="@(() => n.Slug = SlugUtil.From(n.Title))">Föreslå från rubrik</MudButton>
                    @if (SlugChanged(n))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                            Du ändrar länken från <code>@NewsPath(n, _savedSlugs[n])</code>. Den gamla adressen
                            pekas om till den nya (301) när du sparar, så att delade och indexerade länkar fortsätter fungera.
                        </MudAlert>
                    }
                </MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="n.Summary" Label="Ingress (kort)" Variant="Variant.Outlined" Lines="2" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="n.Body" Label="Brödtext (tom rad = nytt stycke)" Variant="Variant.Outlined" Lines="6" /></MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" GutterBottom="true">Bild</MudText>
                    <AdminImageUpload Value="@n.Image" ValueChanged="@(v => n.Image = v)" Subfolder="nyheter" MinWidth="800" MinHeight="450" MaxKb="400"
                                      Spec="Liggande 16:9, ca 800×450 px. JPG/WebP."
                                      ShowAlt="true" AltValue="@n.ImageAlt" AltChanged="@(v => n.ImageAlt = v)" />
                </MudItem>
                <MudItem xs="12">
                    <AdminSeoFields Title="@n.Title" Path="@NewsPath(n)"
                                    Description="@n.SeoDescription" DescriptionChanged="@(v => n.SeoDescription = v)"
                                    Image="@n.SeoImage" ImageChanged="@(v => n.SeoImage = v)"
                                    FallbackDescription="@n.Summary" DescriptionSource="nyhetens ingress"
                                    ImageFallbackText="Tomt fält: nyhetens bild används, annars skolans standardbild." />
                </MudItem>
                <MudItem xs="12">
                    <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@(() => RemoveAsync(n))">Ta bort nyhet</MudButton>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

<div style="display:flex; gap:.75rem">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNews">Lägg till nyhet</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Spara</MudButton>
</div>

@code {
    private static string NewsPath(NewsItem n) => NewsPath(n, n.Slug);
    private static string NewsPath(NewsItem n, string slug) => "/webb/nyheter/" + slug;

    // Länkar som redan var sparade när fliken öppnades. Används för att varna när en
    // befintlig länk ändras. Nya nyheter saknas här och får ingen varning.
    private readonly Dictionary<NewsItem, string> _savedSlugs = new(ReferenceEqualityComparer.Instance);

    protected override void OnInitialized() => RememberSlugs();

    private void RememberSlugs()
    {
        _savedSlugs.Clear();
        foreach (var n in Web.Settings.News.Where(n => !string.IsNullOrWhiteSpace(n.Slug)))
            _savedSlugs[n] = n.Slug;
    }

    private bool SlugChanged(NewsItem n) =>
        _savedSlugs.TryGetValue(n, out var saved) && !string.Equals(saved, n.Slug, StringComparison.Ordinal);

    // Förhandsgranskning gäller alla statusar. Sidan öppnas i ny flik med ?preview=1 och
    // visas bara för inloggad administratör.
    private bool CanPreview(NewsItem n) => !string.IsNullOrWhiteSpace(n.Slug) && SlugError(n) is null;
    private string? PreviewHref(NewsItem n) => CanPreview(n) ? NewsPath(n) + "?preview=1" : null;

    private void AddNews() =>
        Web.Settings.News.Add(new() { Title = "", Slug = "", Date = WebsiteService.Today });

    private static DateTime? ToDateTime(DateOnly? d) => d?.ToDateTime(TimeOnly.MinValue);
    private static DateOnly? ToDateOnly(DateTime? d) => d is null ? null : DateOnly.FromDateTime(d.Value);

    // Sista dag får inte ligga före första dag.
    private static string? PeriodError(NewsItem n) =>
        n.PublishFrom is { } first && n.PublishTo is { } last && last < first
            ? "Sista dag kan inte vara före första dag."
            : null;

    private static string PanelTitle(NewsItem n)
    {
        var title = string.IsNullOrWhiteSpace(n.Title) ? "(ny nyhet)" : n.Title;
        var suffix = n.StatusOn(WebsiteService.Today) switch
        {
            NewsStatus.Scheduled => "  ·  Planerad",
            NewsStatus.Expired   => "  ·  Avpublicerad",
            _                    => "",
        };
        return $"{title}  ·  {n.Date:yyyy-MM-dd}{suffix}";
    }

    private static string StatusText(NewsItem n) => n.StatusOn(WebsiteService.Today) switch
    {
        NewsStatus.Scheduled => $"Planerad. Publiceras {n.PublishFrom:yyyy-MM-dd}.",
        NewsStatus.Expired   => $"Avpublicerad efter {n.PublishTo:yyyy-MM-dd}. Syns inte på webben.",
        _ => n.PublishTo is { } last ? $"Publicerad. Visas till och med {last:yyyy-MM-dd}." : "Publicerad.",
    };

    private static Color StatusColor(NewsItem n) => n.StatusOn(WebsiteService.Today) switch
    {
        NewsStatus.Scheduled => Color.Info,
        NewsStatus.Expired   => Color.Warning,
        _                    => Color.Success,
    };

    // Till skillnad från utbildningar måste en nyhet ha en länk: den har
    // ingen annan väg in än sin egen sida.
    private string? SlugError(NewsItem news) =>
        SlugUtil.Error(news.Slug,
            Web.Settings.News.Where(o => !ReferenceEquals(o, news)).Select(o => o.Slug),
            allowEmpty: false);

    // En sparad nyhet som tas bort lämnar en död adress efter sig. Fråga om den ska peka om.
    private async Task RemoveAsync(NewsItem n)
    {
        if (_savedSlugs.TryGetValue(n, out var saved))
        {
            var from = NewsPath(n, saved);
            var target = await RedirectDialog.AskAsync(Dialogs, from, "/webb/nyheter");
            if (target is null) return; // avbrutet: nyheten ligger kvar
            if (target.Length > 0) Web.AddRedirect(from, target);
            _savedSlugs.Remove(n);
        }

        Web.Settings.News.Remove(n);
    }

    private void Save()
    {
        var trasiga = Web.Settings.News.Count(n => SlugError(n) is not null || PeriodError(n) is not null);
        if (trasiga > 0)
        {
            Snackbar.Add($"Rätta felen på {trasiga} nyhet(er) innan du sparar.", Severity.Error);
            return;
        }

        // Ändrad länk på en sparad nyhet: gamla adressen pekas om till den nya.
        var omPekade = 0;
        foreach (var n in Web.Settings.News.Where(SlugChanged))
        {
            Web.AddRedirect(NewsPath(n, _savedSlugs[n]), NewsPath(n));
            omPekade++;
        }

        Web.Save();
        RememberSlugs();
        Snackbar.Add(omPekade > 0 ? $"Nyheter sparade. {omPekade} gammal(a) adress(er) pekas om (301)." : "Nyheter sparade", Severity.Success);
    }
}

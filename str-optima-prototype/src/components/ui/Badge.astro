---
interface Props {
	variant?: 'success' | 'warning' | 'neutral' | 'info';
}

const { variant = 'neutral' } = Astro.props;

const styles: Record<string, string> = {
	success: 'bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20',
	warning: 'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20',
	neutral: 'bg-gray-100 text-gray-700 ring-1 ring-inset ring-gray-500/10',
	info: 'bg-brand-50 text-brand-700 ring-1 ring-inset ring-brand-600/20',
};
---

<span class:list={['inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium', styles[variant]]}>
	<slot />
</span>

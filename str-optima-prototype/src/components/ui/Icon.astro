---
/**
 * Minimal inline icon set used across the nav and stat cards.
 * Kept as a single component (rather than a library) since the prototype
 * only needs a handful of glyphs.
 */
interface Props {
	name:
		| 'dashboard'
		| 'calendar'
		| 'users'
		| 'user-group'
		| 'building'
		| 'box'
		| 'chart'
		| 'cog'
		| 'invoice'
		| 'chevron-down'
		| 'chevron-right'
		| 'close'
		| 'menu'
		| 'graduation-cap';
	class?: string;
}

const { name, class: className = 'w-5 h-5' } = Astro.props;

const paths: Record<string, string> = {
